# PocketRoute Environment Variables Configuration
# PRD Section 12.1 & 13

# ==============================================================================
# API Service Configuration (apps/api)
# ==============================================================================

# HTTP port for the Fastify API server to listen on. Default: 8080.
PORT=8080

# Host interface to bind to (e.g., 0.0.0.0 for containerized environments).
HOST=0.0.0.0

# Node environment mode: production | development | test. Default: production.
NODE_ENV=production

# Allowed CORS Origin for API requests. Set to your frontend domain in production or '*' for open dev.
CORS_ORIGIN=http://localhost:3000

# Base URL for the optional local or remote Open Source Routing Machine (OSRM) daemon.
# When provided, auto and cab turn-by-turn road geometries are queried from OSRM with 500ms timeout.
# Default if unset: null (falls back to haversine estimation).
# OSRM_BASE_URL=http://localhost:5000

# URL for OpenStreetMap Nominatim reverse geocoding & place search fallback. Default: https://nominatim.openstreetmap.org.
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Rate limit for API requests per client IP per minute. Default: 30.
RATE_LIMIT_PER_MIN=30

# Pino logging verbosity level: 'fatal' | 'error' | 'warn' | 'info' | 'debug' | 'trace'. Default: info.
LOG_LEVEL=info

# Pune transit network data version identifier reported by the /health endpoint. Default: 2026.10.1.
DATA_VERSION=2026.10.1

# ==============================================================================
# Web Application Configuration (apps/web)
# ==============================================================================

# API Base URL prefix used by the frontend HTTP client.
# In production (with Nginx reverse proxy), use '/api/v1'. In local dev, defaults to '/api/v1' or 'http://localhost:8080/api/v1'.
VITE_API_BASE_URL=/api/v1

# Vector map tile JSON style URL. Defaults to OpenFreeMap Bright style (ODbL / free vector tiles).
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright
