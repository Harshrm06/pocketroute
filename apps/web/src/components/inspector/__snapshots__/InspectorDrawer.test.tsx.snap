// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`InspectorDrawer Component > matches snapshot for Overview tab 1`] = `
<DocumentFragment>
  <div
    class="flex flex-col gap-6 text-ink"
  >
    <div
      class="flex flex-col gap-2"
    >
      <h3
        class="font-display text-base font-bold text-ink"
      >
        Multi-Modal RCSPP Algorithm Formulation
      </h3>
      <p
        class="text-xs text-ink-muted leading-relaxed"
      >
        The routing engine solves the multi-modal budget-constrained shortest path problem (RCSPP) over a state graph 
        <span
          class="font-mono text-ink font-semibold"
        >
          S = V × L
        </span>
        , using macro-rides (Rule C) to eliminate intra-line boarding penalties and preserve exact slab pricing. Pruning is guided by backward Dijkstra lower bounds for remaining travel time (
        <span
          class="font-mono text-ink font-semibold"
        >
          LB_t
        </span>
        ) and remaining fare (
        <span
          class="font-mono text-ink font-semibold"
        >
          LB_c
        </span>
        ).
      </p>
    </div>
    <div
      class="flex flex-col gap-2"
    >
      <span
        class="text-xs font-semibold text-ink-muted uppercase tracking-wider"
      >
        Query Graph Dimensions (Current Request)
      </span>
      <div
        aria-label="Query graph dimensions table"
        class="overflow-x-auto rounded-card border border-border bg-surface-solid shadow-e1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-focus"
        role="region"
        tabindex="0"
      >
        <table
          class="w-full text-xs text-left"
        >
          <thead
            class="bg-canvas border-b border-border text-[11px] font-mono text-ink-muted uppercase"
          >
            <tr>
              <th
                class="px-3 py-2"
              >
                Parameter
              </th>
              <th
                class="px-3 py-2"
